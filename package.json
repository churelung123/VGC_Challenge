{
  "name": "discord-ranked-ladder-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Per-server Discord ranked ladder with challenges, match threads, Elo, and moderator disputes",
  "scripts": {
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:global": "tsx src/deploy-commands.ts --global",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/ladder.test.ts",
    "voice": "tsx src/voice-bot.ts",
    "voice-bot": "tsx src/voice-bot.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@neondatabase/serverless": "1.1.0",
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "discord-interactions": "4.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "libsodium-wrappers": "^0.8.4",
    "next": "16.2.6",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "type": "module"
